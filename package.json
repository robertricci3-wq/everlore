{
  "name": "everlore-local",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx src/server/index.ts",
    "worker": "tsx src/server/worker.ts",
    "build": "vite build",
    "start": "NODE_ENV=production tsx src/server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "lint": "eslint src tests",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm build && pnpm test:e2e",
    "lab": "tsx scripts/lab.ts",
    "prodigi": "tsx scripts/prodigi.ts",
    "stripe": "tsx scripts/stripe.ts",
    "commerce": "tsx scripts/commerce.ts",
    "operator": "tsx scripts/operator.ts",
    "backup": "tsx scripts/backup.ts",
    "package:release": "tsx scripts/package-release.ts",
    "openai": "tsx scripts/openai.ts"
  },
  "dependencies": {
    "@fontsource/dm-sans": "5.3.0",
    "@fontsource/literata": "5.3.0",
    "@pdf-lib/fontkit": "1.1.1",
    "express": "5.2.1",
    "lucide-react": "1.50.0",
    "pdf-lib": "1.17.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "0.35.5",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/express": "5.0.6",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "fake-indexeddb": "6.2.5",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.2"
  },
  "packageManager": "pnpm@11.19.0"
}
