# SHELL SETTINGS ONLY. The app does not auto-load .env files.
PORT=4317
DATA_DIR=.data
EVERMORE_LIVE_ENABLED=0
# Request-level verified upper bounds; required for capped hosted trials.
# Unsupported model pricing stops before any request. Does not enable spending.
EVERLORE_STRICT_COST_GUARD=0
# Separate estimated-budget feedback pilot lane. Off until the operator records
# an explicit campaign authorization; never processes Rosa, Lab or legacy jobs.
EVERLORE_PILOT_WORKER=0
# Set a real key privately in the launch environment, never in committed files.
OPENAI_API_KEY=
# Zero means no paid runs. These are reserves, NOT actual billed cost.
# See docs/STORY_ENGINE.md before enabling.
EVERMORE_BUDGET_USD=0
EVERMORE_AUDIO_RESERVE_USD=0
EVERMORE_TEXT_RESERVE_USD=0
EVERMORE_IMAGE_RESERVE_USD=0
